# ── Nexus backend environment ─────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ── LLM providers ────────────────────────────────────────────────────────────
# OpenAI is the PRIMARY provider for every agent; Groq is the automatic fallback,
# Anthropic the last resort. At least one key is required — set OPENAI_API_KEY for
# the intended (primary) path.
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional model / endpoint overrides (defaults are sensible):
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=openai/gpt-oss-20b
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── GitHub (raises rate limits for live AdobeDocs lesson fetches; optional) ──
GITHUB_TOKEN=

# ── Database (required) ───────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/nexus

# ── Persistent vector store (pgvector, optional but recommended) ──
# The shared RAG retriever serves its vector leg from a pgvector index in the
# SAME Postgres (no whole-corpus load per query). Needs the `vector` extension:
#   CREATE EXTENSION IF NOT EXISTS vector;
# then populate it once:  python migrate_to_pgvector.py
# If the extension/packages are missing the retriever transparently falls back to
# the in-memory cosine path, so these are safe to leave at their defaults.
# PGVECTOR_ENABLE=1                 # set 0 to force the legacy in-memory path
# PGVECTOR_TABLE=nexus_docs         # LlamaIndex manages table data_<name>
# PGVECTOR_HNSW=1                   # build an HNSW ANN index (recommended)
# RAG_EMBED_DIM=384                 # must match RAG_EMBED_MODEL's output dim

# ── Adobe IMS OAuth (required for real sign-in; demo login works without it) ──
IMS_CLIENT_ID=
IMS_CLIENT_SECRET=
IMS_SCOPE=openid,AdobeID,additional_info.projectedProductContext
IMS_ENV=prod
IMS_LOCALE=en_US
IMS_REDIRECT_URI=http://localhost:5173/api/auth/callback
FRONTEND_URL=http://localhost:5173

# ── Access control (comma-separated email lists) ──────────────
IMS_ADMIN_EMAILS=
IMS_MANAGER_EMAILS=

# ── Session ───────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
